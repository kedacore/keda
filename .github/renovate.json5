{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // https://docs.renovatebot.com/presets-config/#configbest-practices
    "config:best-practices",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
    "customManagers:makefileVersions",
    "schedule:weekly",
    ":gitSignOff",
    ":prHourlyLimitNone",
  ],
  ignorePresets: [":ignoreModulesAndTests"],
  commitBodyTable: true,
  commitMessagePrefix: "Dependencies:",
  ignorePaths: ["**/vendor/**"],
  labels: ["dependencies", "kind/dependencies"],
  // Give malware scanners and the community time to flag a bad release before
  // we pull it in. vulnerabilityAlerts defaults to minimumReleaseAge: null, so
  // security fixes are not delayed by this.
  minimumReleaseAge: "3 days",
  osvVulnerabilityAlerts: true,
  packageRules: [
    // Registries rarely expose a release timestamp for a tag, and the default
    // minimumReleaseAgeBehaviour (timestamp-required) treats a missing one as
    // "not old enough" and blocks the update outright. Fail open for docker so
    // kindest/node, vishnubijukumar/** and our base images keep updating; every
    // other datasource here does report timestamps, so it stays fail-closed.
    {
      matchDatasources: ["docker"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },

    // --- GitHub Actions ---
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "GitHub Actions (non-major)",
    },

    // --- Go modules ---
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "Go Dependencies (non-major)",
    },
    // Catch-all so unrelated major bumps don't each open their own PR/dashboard entry.
    // Family-specific rules below override this groupName for their packages.
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["major"],
      groupName: "Go Dependencies (major)",
    },
    // Split minor and patch for k8s packages so patch fixes
    // can be merged independently of k8s minor version bumps.
    {
      matchManagers: ["gomod"],
      matchPackageNames: [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-tools",
        "sigs.k8s.io/custom-metrics-apiserver",
      ],
      separateMinorPatch: true,
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-tools",
        "sigs.k8s.io/custom-metrics-apiserver",
      ],
      matchUpdateTypes: ["minor"],
      groupName: "Kubernetes Dependencies",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-tools",
        "sigs.k8s.io/custom-metrics-apiserver",
      ],
      matchUpdateTypes: ["patch", "digest"],
      groupName: "Kubernetes Dependencies",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/prometheus/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Prometheus Dependencies",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/prometheus/**"],
      matchUpdateTypes: ["major"],
      groupName: "Prometheus Dependencies (major)",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: [
        "github.com/aws/aws-sdk-go-v2",
        "github.com/aws/aws-sdk-go-v2/**",
      ],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "AWS SDK",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: [
        "github.com/aws/aws-sdk-go-v2",
        "github.com/aws/aws-sdk-go-v2/**",
      ],
      matchUpdateTypes: ["major"],
      groupName: "AWS SDK (major)",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/Azure/azure-sdk-for-go/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Azure SDK",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/Azure/azure-sdk-for-go/**"],
      matchUpdateTypes: ["major"],
      groupName: "Azure SDK (major)",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["go.opentelemetry.io/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "OpenTelemetry",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["go.opentelemetry.io/**"],
      matchUpdateTypes: ["major"],
      groupName: "OpenTelemetry (major)",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["cloud.google.com/go/**", "google.golang.org/api"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Google Cloud SDK",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["cloud.google.com/go/**", "google.golang.org/api"],
      matchUpdateTypes: ["major"],
      groupName: "Google Cloud SDK (major)",
    },

    // --- Custom regex ---
    // config:best-practices pins digests for every docker datasource, but the
    // custom managers below only capture a version (no currentDigest group and
    // no digest in the file), so Renovate cannot write the pin back and the
    // whole branch update fails. These versions are also interpolated into
    // non-image fields (e.g. kubernetesVersion), where a digest is invalid.
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["docker"],
      pinDigests: false,
    },
    // Deps annotated with @only-patch should only receive patch updates.
    {
      matchManagers: ["custom.regex"],
      matchDepNames: ["/@only-patch/"],
      matchUpdateTypes: ["minor", "major"],
      enabled: false,
    },
    {
      matchManagers: ["custom.regex"],
      matchPackageNames: ["kubernetes-sigs/kind", "kindest/node"],
      groupName: "kind Test Infrastructure",
    },
    {
      matchManagers: ["custom.regex"],
      matchPackageNames: ["vishnubijukumar/**"],
      groupName: "s390x Test Infrastructure",
    },
    // Other one-off e2e/build tooling deps tracked via renovate comments.
    {
      matchDepNames: [
        "argoproj/argo-rollouts",
        "strimzi/strimzi-kafka-operator",
        "protocolbuffers/protobuf",
      ],
      groupName: "Test Infrastructure (misc)",
    },

    // --- Pre-commit ---
    {
      matchManagers: ["pre-commit"],
      separateMajorMinor: false,
      groupName: "Pre-commit Hooks",
    },

    // --- DevContainer ---
    {
      matchFileNames: [".devcontainer/**"],
      pinDigests: false,
      groupName: "DevContainer",
    },

    // Internal main references deliberately follow the latest KEDA build.
    {
      matchPackageNames: [
        "kedacore/keda",
        "ghcr.io/kedacore/keda",
        "ghcr.io/kedacore/keda-admission-webhooks",
        "ghcr.io/kedacore/keda-metrics-apiserver",
      ],
      matchCurrentValue: "main",
      pinDigests: false,
    },
  ],
  customManagers: [
    // Versions in Go source files annotated with // renovate: comments.
    {
      customType: "regex",
      managerFilePatterns: ["**/*.go"],
      matchStrings: [
        '// renovate: datasource=(?<datasource>.+?)\\s+\\S+\\s*=\\s*"(?<depName>.+?):(?<currentValue>.+?)"',
        '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+\\S+\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
    },
    // Versions in YAML list items in workflow files.
    {
      customType: "regex",
      managerFilePatterns: [".github/workflows/**"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?:\\s+packageName=(?<packageName>\\S+))?\\n\\s+- (?<currentValue>\\S+)",
      ],
    },
  ],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  "pre-commit": {
    enabled: true,
  },
  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ["security"],
  },
}
